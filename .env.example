# Observator configuration. Copy to .env and adjust.

# Public URL where Observator is reachable (no trailing slash). Used for links in
# notifications, the Dockerfile snippet, and as passkey (WebAuthn) RP ID and origin.
# Use https in production: session cookies are only marked Secure on https.
APP_URL=http://localhost:3000

# Host port for the web service (docker compose only).
WEB_PORT=3000

# PocketBase superuser. Created/updated on every PocketBase start, and used by the web
# service for all database access. PocketBase is never exposed publicly.
PB_SUPERUSER_EMAIL=admin@observator.local
PB_SUPERUSER_PASSWORD=change-me-to-something-long

# Where the web service reaches PocketBase. docker-compose.yml sets this for you.
# PB_URL=http://pocketbase:8090

# Timezone used as default for the weekly digest schedule (IANA name).
TZ=Europe/Amsterdam

# --- E-mail notifications (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Observator <observator@example.com>"

# --- Tuning (optional) ---
# OBSERVATOR_JOBS=on                 # periodic checks (Node index, OSV, digest, ...)
# INGEST_MAX_BYTES=10485760          # max upload size from the Dockerfile snippet
# INGEST_RATE_LIMIT=60               # reports per project per hour
# SOURCE_URL=https://github.com/EnkodoNL/observator   # "Source code" link in the footer

# --- Self-monitoring ---
# Observator reports its own Node version and packages at startup and daily, as the
# "Observator" project. Set to off to skip.
# OBSERVATOR_SELF=on
