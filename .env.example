# Observator configuration. Copy to .env and adjust.

# Public URL where Observator is reachable (no trailing slash). Used for links in
# notifications, the Dockerfile snippet, and as passkey (WebAuthn) RP ID and origin.
# Use https in production: session cookies are only marked Secure on https.
APP_URL=http://localhost:3000

# Host port for the web service (docker compose only), published on localhost: put a reverse
# proxy in front. WEB_BIND=0.0.0.0 publishes it on every interface; only do that when nothing
# else reaches the port (a firewall), since a direct client can fake X-Forwarded-For.
WEB_PORT=3000
# WEB_BIND=127.0.0.1

# PocketBase superuser. Created/updated on every PocketBase start, and used by the web
# service for all database access. PocketBase is never exposed publicly.
PB_SUPERUSER_EMAIL=admin@observator.local
PB_SUPERUSER_PASSWORD=change-me-to-something-long

# Encrypts stored secrets (deploy webhooks, notification channel credentials) in the database.
# Without it, those cannot be saved. Generate with: openssl rand -base64 32
# Keep a copy outside your backups: a backup together with this key reveals the secrets, and
# without the key they are gone (re-enter them). To rotate, move the old key to
# SECRETS_KEY_PREVIOUS and set a new one; the next start re-encrypts everything.
SECRETS_KEY=
# SECRETS_KEY_PREVIOUS=

# The first account on /setup needs a code that the web container prints to its log, so nobody
# else can claim a fresh install. off: whoever opens /setup first creates it.
# SETUP_CODE=on

# Where the web service reaches PocketBase. docker-compose.yml sets this for you.
# PB_URL=http://pocketbase:8090

# Timezone used as default for the weekly digest schedule (IANA name).
TZ=Europe/Amsterdam

# --- E-mail notifications (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Observator <observator@example.com>"

# --- Tuning (optional) ---
# OBSERVATOR_JOBS=on                 # periodic checks (runtime releases, OSV, digest, ...)
# INGEST_MAX_BYTES=10485760          # max upload size from the Dockerfile snippet
# INGEST_RATE_LIMIT=60               # reports per project per hour
# TRUSTED_PROXIES=1                  # reverse proxies in front that add X-Forwarded-For (Coolify: 1);
#                                    # Cloudflare in front does not count
# TRUST_CLOUDFLARE=off               # on when Cloudflare proxies Observator: take the visitor from CF-Connecting-IP
# SOURCE_URL=https://github.com/EnkodoNL/observator   # "Source code" link in the footer
# REPORTER_IMAGE=ghcr.io/enkodonl/observator-reporter:1   # where the snippet copies the reporter from (a mirror)

# --- Self-monitoring ---
# Observator reports its own Node version and packages at startup and daily, as the
# "Observator" project. Set to off to skip.
# OBSERVATOR_SELF=on
